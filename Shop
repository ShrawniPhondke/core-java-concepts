package Java;

import java.util.Scanner;

public class Shop {
    //===== SHOP =====
//
//        1. Pizza   ₹200
//        2. Burger  ₹150
//        3. Coke    ₹50
//
//        Choose item: 1
//        Enter quantity: 2
//
//        Total = ₹400
//
//        Do you want another item?
//                1. Yes
//        2. No

    static int pizza = 200;
    static int burger = 150;
    static int coke = 50;

    public static void main(String[] args){

        System.out.println("Welcome to shop");

        Scanner scanner = new Scanner(System.in);

        double totalamount = 0;
        int again;

        do {
            System.out.println("1. Pizza   ₹200\n" +
                    "2. Burger  ₹150\n" +
                    "3. Coke    ₹50");

            System.out.println("choose the item :  ");
            int item = scanner.nextInt();

            System.out.println("Enter quantity");
            int quantity = scanner.nextInt();
//            if(quantity >= 10){
//            System.out.println("limit is 10");
//        }else {
//            return;
//        }

            if (item == 1) {

             totalamount = pizza * quantity;
                System.out.println(totalamount);

            }
             else if (item == 2) {
                totalamount = burger * quantity;
                System.out.println(totalamount);

            }
            else if (item == 3) {

                totalamount = coke * quantity;
                System.out.println(totalamount);

            } else {
                System.out.println("Invalid item");
            }


            System.out.println("Current total = ₹" + totalamount);

            System.out.println("\nDo you want another item?");
            System.out.println("1. Yes");
            System.out.println("2. No");

            again = scanner.nextInt();

        }while (again == 1);
        System.out.println("\nFinal Total = ₹" + totalamount);
        System.out.println("Thank you for shopping!");


    }
}
